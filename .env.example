NODE_ENV=development
PORT=4000

# Provided by the database teammate once the real schema is finalized —
# this is a working placeholder pointing at the docker-compose postgres service.
DATABASE_URL=postgresql://skydesk:skydesk@localhost:5432/skydesk?schema=public

# Local dev: the docker-compose redis service.
#   REDIS_URL=redis://localhost:6379
#
# Free-tier hosted option: Upstash Redis (https://upstash.com) — create a
# database there and use the "rediss://" connection string it gives you
# (note the extra "s": that's TLS, which Upstash requires). ioredis
# detects TLS automatically from the "rediss://" scheme, so no code
# changes are needed, just swap this value.
REDIS_URL=redis://localhost:6379

# Must match the secret used by the auth teammate's token-issuing service,
# since this backend only verifies tokens, it doesn't issue them.
JWT_SECRET=replace-with-a-long-random-secret

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Where password-reset links point back to. Defaults to CORS_ORIGIN if unset.
FRONTEND_URL=http://localhost:5173

# Brevo (formerly Sendinblue) transactional email — free tier at
# https://app.brevo.com (300 emails/day). Get your API key from
# https://app.brevo.com/settings/keys/api
# Optional: if unset, emails are skipped (logged, not sent) rather than
# breaking signup/booking/password-reset flows.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@skydesk.io
BREVO_SENDER_NAME=SkyDesk
